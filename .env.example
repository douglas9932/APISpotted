# ============================================================
# APISpotted — SOMENTE servidor (nunca exponha no front)
# Copie para `.env` e preencha. O `.env` real está no .gitignore.
# ============================================================

# ---- IA (modo estrito: SOMENTE banco — docs/tbias.sql) ----
# Seleção (em_uso) e chave (api_key_enc) vêm da tabela. AI_PROVIDER e as
# chaves abaixo são IGNORADAS pelo código; mantidas só como reserva.
AI_PROVIDER=gemini
ANTHROPIC_API_KEY=sua-chave-aqui
GEMINI_API_KEY=sua-chave-aqui
OPENAI_API_KEY=sua-chave-aqui
GEMINI_MODEL=gemini-3.6-flash
OPENAI_MODEL=gpt-4o-mini
# Master key OBRIGATÓRIA (descriptografa tbias.api_key_enc em memória):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IA_MASTER_KEY=sua-master-key-aqui

# ---- Admin das IAs (/api/ias* — ferramenta InstagramConfig) ----
# Sem token: as rotas admin só aceitam conexão localhost E bloqueiam
# Origin/Referer externo. Use a ferramenta contra http://localhost:3001.
# Em deploys públicos (Render/Vercel) elas recusam sozinhas.

# ---- Supabase (F1: /api/publicar grava com service-role) ----
# SERVER-ONLY: service-role bypassa o RLS — vazamento = acesso total.
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_KEY=sua-service-role-key-aqui

# ---- Servidor ----
PORT=3001
