# ============================================================
# APISpotted — SOMENTE servidor (nunca exponha no front)
# Copie para `.env` e preencha. O `.env` real está no .gitignore.
# ============================================================

# ---- IA (modo estrito: SOMENTE banco — docs/tbias.sql) ----
# Seleção (em_uso) e chave (api_key_enc) vêm da tabela. AI_PROVIDER e as
# chaves abaixo são IGNORADAS pelo código; mantidas só como reserva.
AI_PROVIDER=gemini
ANTHROPIC_API_KEY=sua-chave-aqui
GEMINI_API_KEY=sua-chave-aqui
OPENAI_API_KEY=sua-chave-aqui
GROQ_API_KEY=gsk_...-sua-chave-aqui
GEMINI_MODEL=gemini-3.6-flash
OPENAI_MODEL=gpt-4o-mini
GROQ_MODEL=llama-3.3-70b-versatile
# Master key OBRIGATÓRIA (descriptografa tbias.api_key_enc em memória):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IA_MASTER_KEY=sua-master-key-aqui

# ---- Timeout da IA (opcional) ----
# Quanto tempo esperar a IA antes de desistir (ms). Padrão 45000.
# Se a IA estiver lenta e você vir "Gemini timeout após ...ms" no log,
# aumente (ex: 60000). Mín 5000, máx 120000.
# AI_TIMEOUT_MS=45000

# ---- Admin das IAs (/api/ias* — ferramenta InstagramConfig) ----
# Opção A (local): sem ADMIN_TOKEN, só aceita localhost (127.x) e bloqueia Origin externo
# Opção B (Render/produção): defina ADMIN_TOKEN (ex: openssl rand -hex 32) e
#   configure o mesmo token no InstagramConfig (ele envia x-admin-token).
#   Com token, a API aceita de qualquer IP (inclusive Render) se o header bater.
# ADMIN_TOKEN=seu-token-secreto-aqui-com-32+chars
# Sem token: as rotas admin só aceitam conexão localhost E bloqueiam
# Origin/Referer externo. Use a ferramenta contra http://localhost:3001.
# Em deploys públicos (Render/Vercel) sem token elas recusam sozinhas.

# ---- Supabase (F1: /api/publicar grava com service-role) ----
# SERVER-ONLY: service-role bypassa o RLS — vazamento = acesso total.
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_KEY=sua-service-role-key-aqui

# ---- Servidor ----
PORT=3001
